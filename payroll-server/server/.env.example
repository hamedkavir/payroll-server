# این فایل را کپی کنید به نام .env و مقادیر واقعی را جایگزین کنید
# cp .env.example .env

# اتصال به MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=payslip_user
DB_PASSWORD=یک-رمز-قوی-اینجا
DB_NAME=payslip_db

# پورتی که سرور روی آن اجرا می‌شود
PORT=4000

# کلید دسترسی سادهٔ API — همان مقدار را در برنامهٔ فرانت‌اند (payslip-online.html) هم وارد کنید
# یک رشتهٔ تصادفی طولانی اینجا بگذارید، نه چیزی قابل‌حدس
API_KEY=یک-رشتهٔ-تصادفی-طولانی-اینجا

# آدرس(های) مجاز برای CORS، جدا با کاما؛ * یعنی همه (برای تست، نه برای تولید)
CORS_ORIGIN=*

# اختیاری: رند کردن مبلغ وام و قسط نوبت وام به نزدیک‌ترین مضرب این عدد (پیش‌فرض: بدون رند)
# LOAN_ROUND_STEP=1000000

# اختیاری: اندازهٔ sort buffer هر اتصال به بایت (پیش‌فرض ۸ مگابایت)
# SORT_BUFFER_SIZE=8388608

# پشتیبان‌گیری (اختیاری)
# BACKUP_AUTO=1            # 0 = پشتیبان خودکار غیرفعال
# BACKUP_EVERY_HOURS=24
# BACKUP_KEEP=14           # تعداد پشتیبان‌های خودکار نگه‌داشته‌شده
# BACKUP_DIR=../backups    # پوشهٔ ذخیره (بهتر است روی دیسک جدا باشد)
# BACKUP_MAX_MB=4096       # سقف حجم فایل آپلود
